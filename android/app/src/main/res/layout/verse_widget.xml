<?xml version="1.0" encoding="utf-8"?>
<!-- «آية اليوم» (VerseWidgetProvider). The verse shrinks to fit rather
     than being cut off; the app draws verses short enough for it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/verse_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/khatma_widget_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/verse_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="#B8923E"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/verse_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="22sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeTextType="uniform"
        android:gravity="center_vertical|start"
        android:lineSpacingMultiplier="1.15"
        android:textAlignment="viewStart"
        android:textColor="#F4EEDD"
        android:textDirection="rtl"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/verse_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="#C9D4CC"
        android:textSize="12sp" />
</LinearLayout>
