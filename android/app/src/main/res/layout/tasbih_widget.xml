<?xml version="1.0" encoding="utf-8"?>
<!-- «المسبحة» widget (TasbihWidgetProvider): the dhikr, today's count and
     a button that counts without opening the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tasbih_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/khatma_widget_background"
    android:gravity="center_vertical"
    android:layoutDirection="locale"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tasbih_dhikr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#B8923E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tasbih_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F2EBDD"
            android:textSize="30sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tasbih_button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/tasbih_widget_button"
        android:contentDescription="@string/tasbih_count">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/tasbih_count"
            android:textColor="#1B2A2A"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
