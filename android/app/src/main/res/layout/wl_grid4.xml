<?xml version="1.0" encoding="utf-8"?>
<!-- A widget in the app's interface look (WidgetLooks.kt): the picture the
     app drew with the day's text drawn in, and see-through tap targets laid
     over its buttons, as widget_art.dart places them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wl_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <View android:id="@+id/wl_t0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <View android:id="@+id/wl_t1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <View android:id="@+id/wl_t2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        <View android:id="@+id/wl_t3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
